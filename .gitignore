# ---- Obsidian 本机工作区状态（频繁变动，同步会冲突）----
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# ---- Claudian 会话记录（仅本机保留）----
.claudian/sessions/

# ---- Obsidian Git 插件本地配置（含 GitHub Token，严禁提交）----
.obsidian/plugins/obsidian-git/data.json
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# ---- 系统与临时文件 ----
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*
